# ====================================================================
# VARIÁVEIS DE AMBIENTE - SISTEMA DE ETIQUETAS NFT LOGISTICS
# ====================================================================
# ATENÇÃO: NUNCA suba arquivos .env com valores reais para o Git!
# Configure estas variáveis na Vercel (Project Settings > Environment Variables)
# ====================================================================

# 1. Configurações de Autenticação Segura (Auth.js / Backend)
# IMPORTANTE: Chave secreta de alta entropia para assinatura de tokens/sessões (NUNCA expor no cliente)
AUTH_SECRET=sua_chave_secreta_super_aleatoria_minimo_32_caracteres_aqui
AUTH_TRUST_HOST=true

# 2. Segurança de Rede / API Python & Microserviços
# Origens permitidas pelo CORS (sem wildcard '*' com credenciais)
ALLOWED_ORIGIN=https://seu-dominio.vercel.app
# Chave secreta de comunicação interna server-to-server
INTERNAL_API_KEY=sua_chave_interna_secreta_aqui

# 3. Credenciais Padrão do Sistema (Opcional - sobrescreve admin padrão)
# Use apenas se necessário no front-end em tempo de build/Vite
VITE_AUTH_USER=admin
VITE_AUTH_PASSWORD=nft@2026
